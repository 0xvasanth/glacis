# Database
DATABASE_URL=postgresql+asyncpg://glacis:glacis@localhost:5432/glacis

# Anthropic Claude. Default model is Haiku (cheapest); switch LLM_MODEL to a
# Sonnet/Opus id when accuracy matters more than per-token cost.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Worker
WORKER_POLL_INTERVAL_S=1.0
WORKER_MAX_ATTEMPTS=5
WORKER_REAPER_INTERVAL_S=60
WORKER_STALE_LOCK_MINUTES=5

# API
LOG_LEVEL=INFO
