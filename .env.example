# Database
DATABASE_URL=postgresql+asyncpg://glacis:glacis@localhost:5432/glacis

# Google AI Studio (Gemini). Default model: gemini-2.5-flash.
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Worker
WORKER_POLL_INTERVAL_S=1.0
WORKER_MAX_ATTEMPTS=5
WORKER_REAPER_INTERVAL_S=60
WORKER_STALE_LOCK_MINUTES=5

# API
LOG_LEVEL=INFO
